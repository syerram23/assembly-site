---
const groups = [
  {
    n: "01",
    title: "Sign in & stay secure",
    body: "Company sign-on, role-based permissions, and a full audit trail, built in.",
    items: ["SSO via Okta or Entra", "SCIM provisioning", "Role-scoped reviewer access", "Full audit lineage on every call"],
  },
  {
    n: "02",
    title: "Your data, ready to use",
    body: "A governed data layer that keeps your systems in sync and searchable.",
    items: ["Connectors · Workday, Salesforce, Snowflake, Postgres, more", "Schema-aware governance", "RAG-ready embeddings", "Customer-isolated inference"],
  },
  {
    n: "03",
    title: "Reach people",
    body: "Apps can send email, text, and notifications without wiring up a thing.",
    items: ["Email · SES, SendGrid, M365", "Slack · Teams · web push", "SMS · voice intake", "Reviewer-queue notifications"],
  },
  {
    n: "04",
    title: "Build faster",
    body: "Ready-made components, scheduled jobs, and document generation out of the box.",
    items: ["Pre-built UI primitives", "Cron + durable workflows", "Document & report generation", "Browser automation primitive"],
  },
  {
    n: "05",
    title: "Run with confidence",
    body: "Hosting, monitoring, and production-grade reliability, managed for you.",
    items: ["Hosted on Assembly AWS or your VPC", "Single-tenant managed option", "99.9% SLA · 24/5 support", "SOC 2 Type II · ISO 27001 (in progress)"],
  },
];
---

<section class="included" id="included">
  <div class="wrap">
    <div class="s-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>What's included</span>
        <h2>Everything your team needs to build &mdash;<br/><em>from day one</em>.</h2>
      </div>
      <div class="right">
        <p>
          Logins, permissions, your connected data, email, search, hosting, audit trails &mdash; the parts that normally take weeks to assemble are already there. <b>Your team brings the idea; everything underneath is handled.</b>
        </p>
      </div>
    </div>

    <div class="grid">
      {
        groups.map(({ n, title, body, items }) => (
          <article class="grp lift">
            <header>
              <span class="num">{n}</span>
              <h3>{title}</h3>
            </header>
            <p class="g-body">{body}</p>
            <ul>
              {items.map((it) => (
                <li>
                  <span class="check" aria-hidden>›</span>
                  {it}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <a href="/platform" class="see-all">
      <span>See everything that's included</span>
      <span class="arr">→</span>
    </a>
  </div>
</section>

<style>
  .included {
    padding: 120px 0;
    border-top: 1px solid var(--color-ink-100);
    background: #fff;
  }

  .s-head {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    margin-bottom: 56px;
    align-items: start;
  }
  @media (max-width: 920px) { .s-head { grid-template-columns: 1fr; gap: 24px; } }
  .s-head .left .eyebrow { margin-bottom: 14px; display: block; }
  .s-head h2 em { font-style: normal; color: var(--color-indigo-600); }
  .s-head .right p { color: var(--color-ink-500); font-size: 18px; max-width: 680px; }
  .s-head .right p b { color: var(--color-ink-950); font-weight: 600; }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 980px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }

  .grp {
    background: #fff;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 3px solid var(--color-indigo-600);
  }
  .grp header {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .grp .num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-ink-400);
  }
  .grp h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.012em;
    line-height: 1.2;
  }
  .grp .g-body {
    color: var(--color-ink-500);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .grp ul {
    list-style: none;
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed var(--color-ink-200);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .grp li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--color-ink-700);
    letter-spacing: 0.01em;
    line-height: 1.5;
  }
  .grp .check {
    color: var(--color-indigo-600);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
  }

  .see-all {
    margin-top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border-radius: 999px;
    background: var(--color-indigo-600);
    color: #fff;
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    transition: background 0.15s, box-shadow 0.15s;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 10px 28px -12px rgba(79, 70, 229, 0.5);
  }
  .see-all:hover { background: var(--color-indigo-700); }
  .see-all .arr { transition: transform 0.2s; }
  .see-all:hover .arr { transform: translateX(3px); }
</style>
