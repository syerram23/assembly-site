---
/*
 * Assembly vs. vanilla Claude Code.
 *
 * The competitive frame: every capability the platform hands you, re-cut
 * as a cost you would carry alone. The point of the table is the
 * lopsidedness — "Day one with Assembly: all 21 included. Day one with
 * vanilla Claude Code: 21 separate things to evaluate, sign up for,
 * wire in, secure, and maintain."
 */

const rows = [
  {
    group: "Sign in & stay secure",
    items: [
      { cap: "Single sign-on",         dyi: "Choose an auth provider, configure SAML/OIDC, wire it into every app" },
      { cap: "Roles & permissions",    dyi: "Hand-build a permission model and enforce it in app code yourself" },
      { cap: "User & team management", dyi: "Build user and org tables, plus a management UI, from scratch" },
      { cap: "Audit trail",            dyi: "Build your own action logging &mdash; usually skipped until an audit demands it" },
    ],
  },
  {
    group: "Your data, ready to use",
    items: [
      { cap: "Governed data plane",     dyi: "No data layer &mdash; wire up each source yourself, with no governance" },
      { cap: "Live connectors",         dyi: "Build and maintain each integration: OAuth, rate limits, API changes" },
      { cap: "Search across everything", dyi: "Stand up a vector database and build an embedding + indexing pipeline" },
      { cap: "Files & documents",       dyi: "Wire up file storage and a document-parsing pipeline yourself" },
      { cap: "Secure storage",          dyi: "Provision a database, then configure encryption and backups" },
    ],
  },
  {
    group: "Reach people",
    items: [
      { cap: "Email",              dyi: "Sign up for SendGrid, get IT approval, wire the API into each app" },
      { cap: "SMS & phone",        dyi: "Sign up for Twilio, provision numbers, configure messaging" },
      { cap: "Comms conversations", dyi: "Not available &mdash; build a multi-modal conversation engine yourself" },
      { cap: "In-app notifications", dyi: "Build your own notification system and UI" },
    ],
  },
  {
    group: "Build faster",
    items: [
      { cap: "Ready-made components", dyi: "Build every table, form, and dashboard component from scratch, per app" },
      { cap: "Scheduled jobs",        dyi: "Set up your own cron and scheduling infrastructure" },
      { cap: "Document generation",   dyi: "Build a templating and PDF-rendering pipeline yourself" },
      { cap: "Secrets handling",      dyi: "Manage .env files or a secrets manager yourself &mdash; easy to leak" },
    ],
  },
  {
    group: "Run with confidence",
    items: [
      { cap: "Hosting & backups",    dyi: "Choose a host, configure deployments, set up backups yourself" },
      { cap: "Error monitoring",     dyi: "Sign up for Sentry or Datadog and instrument every app" },
      { cap: "Production workflows", dyi: "Build durable workflow infrastructure &mdash; retries, state &mdash; not vibe-codeable" },
      { cap: "Admin & governance",   dyi: "No central admin &mdash; manage each app separately, or not at all" },
    ],
  },
];

const total = rows.reduce((acc, g) => acc + g.items.length, 0);
---

<section class="vscc" id="vs-claude-code">
  <div class="wrap">
    <div class="s-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>Why not vanilla Claude Code?</span>
        <h2>
          Every capability &mdash; Assembly<br />
          vs. <em>do-it-yourself</em>.
        </h2>
      </div>
      <div class="right">
        <p>
          AI coding tools generate code; they don't ship enterprise infrastructure. Every capability the platform hands your team, re-cut as a cost you'd carry alone &mdash; the integrations, the auth, the audit, the durable workflow engine, all twenty-one of them. <b>None of which is the app you actually wanted to build.</b>
        </p>
      </div>
    </div>

    <div class="table">
      <header class="thead">
        <span class="th-cap">Capability</span>
        <span class="th-as">
          <span class="dot ok"></span>
          Assembly
        </span>
        <span class="th-cc">
          <span class="dot bad"></span>
          Vanilla Claude Code
        </span>
      </header>

      {
        rows.map(({ group, items }) => (
          <>
            <div class="trow group-row">
              <span class="grow-num">{String(rows.indexOf({ group, items }) + 1).padStart(2, "0")}</span>
              <span class="grow-lbl">{group}</span>
              <span class="grow-count">{items.length}</span>
            </div>
            {
              items.map(({ cap, dyi }) => (
                <div class="trow item">
                  <span class="td-cap">{cap}</span>
                  <span class="td-as">
                    <span class="ok-dot"></span>
                    Included
                  </span>
                  <span class="td-cc" set:html={dyi}></span>
                </div>
              ))
            }
          </>
        ))
      }
    </div>

    <div class="vscc-foot">
      <span class="vf-l">
        <b>Day one with Assembly</b>: all {total}, included.
      </span>
      <span class="vf-r">
        Day one with vanilla Claude Code: {total} separate things to evaluate, sign up for, wire in, secure, and maintain &mdash; none of which is the app you actually wanted to build.
      </span>
    </div>
  </div>
</section>

<style>
  .vscc {
    padding: 120px 0;
    border-top: 1px solid var(--color-ink-100);
    background: #fff;
  }

  .s-head {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    margin-bottom: 48px;
    align-items: start;
  }
  @media (max-width: 920px) { .s-head { grid-template-columns: 1fr; gap: 24px; } }
  .s-head .left .eyebrow { margin-bottom: 14px; display: block; }
  .s-head h2 em { font-style: normal; color: var(--color-indigo-600); }
  .s-head .right p { color: var(--color-ink-500); font-size: 18px; max-width: 680px; line-height: 1.55; }
  .s-head .right p b { color: var(--color-ink-950); font-weight: 600; }

  .table {
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-ink-950);
  }

  .thead {
    display: grid;
    grid-template-columns: minmax(180px, 1.2fr) 1fr 2fr;
    gap: 1px;
    background: var(--color-ink-950);
  }
  .thead > span {
    padding: 14px 18px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--color-ink-950);
    color: rgba(255, 255, 255, 0.55);
  }
  .thead .th-as {
    color: var(--color-sage-bg);
    background: rgba(214, 235, 219, 0.06);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .thead .th-cc {
    color: #f8d6d6;
    background: rgba(248, 200, 200, 0.06);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .thead .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .thead .dot.ok { background: var(--color-sage-bg); }
  .thead .dot.bad { background: #f0a5a5; }

  .trow {
    display: grid;
    grid-template-columns: minmax(180px, 1.2fr) 1fr 2fr;
    gap: 1px;
    background: var(--color-ink-200);
  }
  .trow > span {
    padding: 12px 18px;
    background: #fff;
  }

  /* Group header rows */
  .group-row {
    grid-template-columns: 1fr;
    padding: 0;
  }
  .group-row > span:first-child { display: none; }
  .group-row .grow-num {
    display: inline;
    background: transparent;
    padding: 14px 18px 4px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.4);
  }
  .group-row .grow-lbl {
    background: transparent;
    padding: 0 18px 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.012em;
    color: #fff;
    grid-column: 1 / -1;
  }
  .group-row .grow-count {
    background: transparent;
    padding: 0 18px 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    justify-self: end;
  }
  .group-row {
    background: var(--color-ink-950);
    grid-template-columns: auto 1fr auto;
    align-items: center;
    padding: 0 0 4px;
  }

  /* Item rows */
  .item .td-cap {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-ink-950);
    font-weight: 500;
    background: var(--color-ink-50);
  }
  .item .td-as {
    background: rgba(214, 235, 219, 0.25);
    color: var(--color-sage-fg);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .item .ok-dot {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--color-sage-fg);
  }
  .item .td-cc {
    background: #fbf0f0;
    color: #8a4a4a;
    font-size: 13.5px;
    line-height: 1.5;
  }

  @media (max-width: 820px) {
    .thead, .item { grid-template-columns: 1fr; }
    .item { padding: 12px 18px; }
    .item > span { padding: 6px 0; border-radius: 0; }
    .item .td-cap { padding-top: 12px; }
    .item .td-as,
    .item .td-cc {
      background: transparent;
      padding: 4px 0;
    }
    .item .td-cc { padding-bottom: 12px; }
  }

  .vscc-foot {
    margin-top: 24px;
    padding: 22px 28px;
    background: var(--color-ink-50);
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-md);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    align-items: center;
  }
  @media (max-width: 720px) {
    .vscc-foot { grid-template-columns: 1fr; gap: 12px; }
  }
  .vf-l {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.012em;
    color: var(--color-ink-950);
    white-space: nowrap;
  }
  .vf-l b {
    color: var(--color-indigo-600);
    font-weight: 600;
  }
  .vf-r {
    color: var(--color-ink-500);
    font-size: 14.5px;
    line-height: 1.55;
  }
</style>
