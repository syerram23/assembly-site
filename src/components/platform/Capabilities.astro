---
/*
 * What's actually in the box — five capability groups.
 *
 * Layout: section header (eyebrow + h2 + right-rail lede),
 * then a 5-card grid. Each card has a numbered eyebrow,
 * a one-line "promise", and a typed feature list with
 * mono identifiers (so it reads like a docs page).
 */

const groups = [
  {
    num: "01",
    kind: "identity",
    title: "Sign in & stay secure",
    promise:
      "Every app you build inherits enterprise identity from the moment it's deployed.",
    features: [
      { id: "sso.okta",          desc: "SSO via Okta, Entra, Google, Ping" },
      { id: "scim",              desc: "Just-in-time SCIM provisioning + deprovisioning" },
      { id: "rbac",              desc: "Role-scoped access, per-app and per-action" },
      { id: "audit.trail",       desc: "Append-only audit of every user, model, and data call" },
      { id: "session.policy",    desc: "Idle timeout, IP allow-list, device posture (optional)" },
    ],
    foot: "Compliance posture: SOC 2 Type II · ISO 27001 (in progress) · HIPAA / GLBA-aligned",
  },
  {
    num: "02",
    kind: "data",
    title: "Your data, ready to use",
    promise:
      "A governed data layer that knows your schema — and what an LLM is allowed to see.",
    features: [
      { id: "connectors.hr",     desc: "Workday · Greenhouse · Lever · BambooHR · ADP" },
      { id: "connectors.crm",    desc: "Salesforce · HubSpot · Zendesk · ServiceNow" },
      { id: "connectors.data",   desc: "Snowflake · Postgres · BigQuery · Databricks · S3" },
      { id: "schema.aware",      desc: "Typed columns, PII tags, row-level policies enforced" },
      { id: "sync.modes",        desc: "Real-time webhook · scheduled · query-on-read" },
    ],
    foot: "Read-only by default. Writes require an explicit, named OAuth scope per app.",
  },
  {
    num: "03",
    kind: "reach",
    title: "Reach people",
    promise:
      "Notification primitives that route through the channels your team already lives in.",
    features: [
      { id: "channel.email",     desc: "Transactional email with DKIM, branding, threading" },
      { id: "channel.sms",       desc: "Two-way SMS with opt-in, MMS, regional carriers" },
      { id: "channel.slack",     desc: "Slack app + slash commands, no separate workspace" },
      { id: "channel.teams",     desc: "Microsoft Teams bot + adaptive cards" },
      { id: "channel.voice",     desc: "Outbound voice + IVR; inbound numbers per app" },
    ],
    foot: "Quiet-hours, escalation chains, and reviewer SLAs are first-class primitives.",
  },
  {
    num: "04",
    kind: "build",
    title: "Build faster",
    promise:
      "Pre-built primitives so your team writes the business logic, not the plumbing.",
    features: [
      { id: "ui.components",     desc: "Forms, queues, review surfaces, dashboards" },
      { id: "jobs.schedule",     desc: "Cron + event-driven jobs with retry semantics" },
      { id: "docgen",            desc: "Branded PDFs, DOCX, CSV from typed templates" },
      { id: "search.rag",        desc: "Hybrid retrieval with policy-aware filtering" },
      { id: "browser.headless",  desc: "Sandboxed browser automation for legacy systems" },
    ],
    foot: "Every primitive is typed end-to-end. No untyped JSON crossing app boundaries.",
  },
  {
    num: "05",
    kind: "operate",
    title: "Run with confidence",
    promise:
      "Hosting, monitoring, and SLAs that look like a platform team, not a side project.",
    features: [
      { id: "hosting.managed",   desc: "Assembly-managed multi-tenant, on Assembly AWS" },
      { id: "hosting.single",    desc: "Single-tenant deploy in your VPC (managed for you)" },
      { id: "obs.metrics",       desc: "Per-app traces, latency, error rates, cost-per-run" },
      { id: "obs.alerts",        desc: "Webhook & PagerDuty alerts on SLOs you set" },
      { id: "sla.tiers",         desc: "99.9% standard · 99.95% enterprise · custom on request" },
    ],
    foot: "Your data, your keys, your environment. We hold the operational pager.",
  },
];
---

<section class="caps" id="capabilities">
  <div class="wrap">
    <div class="caps-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>What's in the box</span>
        <h2 style="margin-top:18px">
          The infrastructure underneath an AI app, <em>already built</em>.
        </h2>
      </div>
      <div class="right">
        <p>
          Every team that tries to wire AI into production runs into the
          same wall: it's not the model that's hard, it's the
          twenty things around it. Identity. A governed data layer.
          Notifications. Document generation. Audit. Hosting. We ship
          all of it as a single platform — so the only thing your
          team has to figure out is the part only they can.
        </p>
      </div>
    </div>

    <div class="caps-grid">
      {groups.map((g) => (
        <article class={`cap kind-${g.kind} lift`}>
          <header class="cap-head">
            <span class="cap-num">{g.num}</span>
            <span class={`cap-kind ${g.kind}`}>{g.kind}</span>
          </header>
          <h3 class="cap-title">{g.title}</h3>
          <p class="cap-promise">{g.promise}</p>
          <ul class="cap-feat">
            {g.features.map((f) => (
              <li>
                <span class="f-id">{f.id}</span>
                <span class="f-desc">{f.desc}</span>
              </li>
            ))}
          </ul>
          <div class="cap-foot">{g.foot}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .caps {
    padding-top: 96px;
    padding-bottom: 96px;
    border-top: 1px solid var(--color-ink-100);
    background: var(--color-ink-50);
  }

  .caps-head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: end;
    margin-bottom: 48px;
  }
  @media (max-width: 900px) {
    .caps-head { grid-template-columns: 1fr; gap: 24px; }
  }
  .caps-head h2 em {
    font-style: normal;
    color: var(--color-indigo-600);
  }
  .caps-head .right p {
    color: var(--color-ink-500);
    font-size: 16px;
    line-height: 1.55;
    max-width: 520px;
  }

  .caps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  /* On the 2nd row, the first capability spans 2 cols to break monotony,
     then row 2 has 2 cols. But to keep it simple and stable, use a
     12-col grid where each card spans 4 cols on row 1 (3 cards),
     and on row 2 the last two cards each span 6 cols. */
  @media (min-width: 901px) {
    .caps-grid {
      grid-template-columns: repeat(12, 1fr);
    }
    .cap:nth-child(1),
    .cap:nth-child(2),
    .cap:nth-child(3) {
      grid-column: span 4;
    }
    .cap:nth-child(4),
    .cap:nth-child(5) {
      grid-column: span 6;
    }
  }
  @media (max-width: 900px) {
    .caps-grid { grid-template-columns: 1fr; }
  }

  .cap {
    background: #fff;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-lg);
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 100%;
  }
  .cap-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cap-num {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-400);
    letter-spacing: 0.14em;
  }
  .cap-kind {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 3px 7px;
    border-radius: 4px;
    background: var(--color-indigo-100);
    color: var(--color-indigo-700);
  }
  .cap-kind.data    { background: #E5F1FC; color: #1F5C8F; }
  .cap-kind.reach   { background: var(--color-amber-bg); color: var(--color-amber-fg); }
  .cap-kind.build   { background: var(--color-sage-bg); color: var(--color-sage-fg); }
  .cap-kind.operate { background: var(--color-ink-100); color: var(--color-ink-700); }

  .cap-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--color-ink-950);
    line-height: 1.15;
    margin: 0;
  }
  .cap-promise {
    color: var(--color-ink-500);
    font-size: 14.5px;
    line-height: 1.5;
    margin: 0;
  }
  .cap-feat {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cap-feat li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    padding: 10px 12px;
    background: var(--color-ink-50);
    border: 1px solid var(--color-ink-100);
    border-radius: var(--radius-md);
  }
  .f-id {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-indigo-700);
    letter-spacing: -0.005em;
    font-weight: 500;
  }
  .f-desc {
    font-size: 13.5px;
    color: var(--color-ink-700);
    line-height: 1.4;
  }
  .cap-foot {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px dashed var(--color-ink-200);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-ink-500);
    letter-spacing: 0.02em;
    line-height: 1.5;
  }
</style>
