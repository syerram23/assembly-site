---
const rows = [
  { k: "Identity", v: "SSO via Okta or Entra. SCIM provisioning. Role-scoped access. <b>Every app your team builds inherits SSO automatically.</b>" },
  { k: "Audit lineage", v: "Every read, every transform, every endpoint call writes a row. Replayable end-to-end. The trail an examiner would ask for &mdash; already there." },
  { k: "Data residency", v: "Customer data stays in your systems. <b>No copies, no cross-tenant inference.</b> Single-tenant deploy option in your VPC." },
  { k: "Human-in-the-loop", v: "Every policy-gated action surfaces in a named reviewer's queue with SLA. <b>No silent autonomous decisioning.</b>" },
  { k: "Compliance", v: "SOC 2 Type II · ISO 27001 (in progress) · HIPAA &amp; GLBA-aligned data handling. Regulated-environment ready." },
  { k: "Model isolation", v: "No training on your data, period. Model audit log retained for the life of the tenancy." },
];
---

<section class="pgov" id="governance">
  <div class="wrap">
    <div class="s-head">
      <div class="left">
        <span class="eyebrow"><span class="dot"></span>Governance, not bolted on</span>
        <h2>Every app you build inherits this &mdash;<br /><em>automatically</em>.</h2>
      </div>
      <div class="right">
        <p>
          The reason a non-engineer can ship to production safely: the platform forces the governance posture, not the developer. <b>Identity, audit, data residency, HITL, compliance posture &mdash; they're not features. They're invariants.</b>
        </p>
      </div>
    </div>

    <div class="gov-card">
      <div class="gov-rows">
        {
          rows.map(({ k, v }) => (
            <div class="r">
              <span class="k">{k}</span>
              <span class="v" set:html={v} />
            </div>
          ))
        }
      </div>
      <footer class="gov-foot">
        <div class="badges">
          <span class="b-pill">SOC 2 Type II</span>
          <span class="b-pill">ISO 27001 <small>in progress</small></span>
          <span class="b-pill">HIPAA aligned</span>
          <span class="b-pill">GLBA aligned</span>
        </div>
        <a href="#" class="trust-link">
          Open the trust report <span class="arr">→</span>
        </a>
      </footer>
    </div>
  </div>
</section>

<style>
  .pgov {
    padding: 120px 0;
    border-top: 1px solid var(--color-ink-100);
    background: var(--color-ink-50);
  }
  .s-head {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    margin-bottom: 56px;
    align-items: start;
  }
  @media (max-width: 920px) { .s-head { grid-template-columns: 1fr; gap: 24px; } }
  .s-head .left .eyebrow { margin-bottom: 14px; display: block; }
  .s-head h2 em { font-style: normal; color: var(--color-indigo-600); }
  .s-head .right p { color: var(--color-ink-500); font-size: 18px; max-width: 680px; }
  .s-head .right p b { color: var(--color-ink-950); font-weight: 600; }

  .gov-card {
    background: #fff;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-xl);
    padding: 36px 40px;
  }
  .gov-rows { display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }
  @media (max-width: 900px) { .gov-rows { grid-template-columns: 1fr; gap: 0; } }
  .gov-rows .r {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 18px;
    padding: 16px 0;
    border-top: 1px solid var(--color-ink-100);
    align-items: start;
  }
  .gov-rows .r:nth-child(1),
  .gov-rows .r:nth-child(2) { border-top: 0; }
  @media (max-width: 900px) { .gov-rows .r:nth-child(2) { border-top: 1px solid var(--color-ink-100); } }
  .gov-rows .r .k {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-500);
    padding-top: 4px;
  }
  .gov-rows .r .v {
    font-size: 14px;
    color: var(--color-ink-700);
    line-height: 1.55;
  }
  .gov-rows .r .v :global(b) { color: var(--color-ink-950); font-weight: 600; }

  .gov-foot {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--color-ink-100);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }
  .badges { display: flex; gap: 8px; flex-wrap: wrap; }
  .b-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-700);
    background: var(--color-ink-50);
    border: 1px solid var(--color-ink-200);
    padding: 5px 12px;
    border-radius: 999px;
  }
  .b-pill small {
    font-family: var(--font-body);
    font-size: 9.5px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--color-ink-500);
    margin-left: 4px;
  }
  .trust-link {
    display: inline-flex;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-indigo-600);
    text-decoration: none;
    align-items: center;
  }
  .trust-link .arr { transition: transform 0.2s; }
  .trust-link:hover .arr { transform: translateX(3px); }
</style>
