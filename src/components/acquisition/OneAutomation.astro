---
/*
 * One Automation — what it takes to stand up just ONE enterprise-grade
 * AI automation without Assembly.
 *
 * Brutal step-by-step view: 21 separate decisions, 5+ teams, $200k+ in
 * vendor commitments, 12+ weeks before the business logic gets written.
 * Then show: with Assembly, all 21 are pre-built and shared across every
 * automation the team ever ships.
 */

const steps = [
  { phase: "01 · Identity",  i: "Choose SSO/SAML provider",   t: "2 wks", v: "Okta · Entra · Auth0",         cost: "$50k+/yr seat fee" },
  { phase: "01 · Identity",  i: "Build role-based permissions", t: "1 wk", v: "in-house ·  re-build each app", cost: "engineering hours" },
  { phase: "01 · Identity",  i: "User & team management UI",    t: "2 wks", v: "in-house",                      cost: "engineering hours" },
  { phase: "01 · Identity",  i: "Audit log — write & retain",   t: "1 wk",  v: "Splunk · Datadog · in-house",   cost: "$30k+/yr + ENG" },
  { phase: "02 · Data",      i: "Governed data plane",         t: "3 wks", v: "in-house · Atlan · Collibra",   cost: "$80k+/yr" },
  { phase: "02 · Data",      i: "Connectors to source systems", t: "2 wks ea", v: "Fivetran · Airbyte · in-house", cost: "$15k+/yr/connector" },
  { phase: "02 · Data",      i: "Search / RAG pipeline",       t: "2 wks", v: "Pinecone · Weaviate · in-house", cost: "$24k+/yr" },
  { phase: "02 · Data",      i: "File & document storage",     t: "1 wk",  v: "S3 + parsing pipeline",          cost: "compute + ENG" },
  { phase: "02 · Data",      i: "Encrypted DB + backups",      t: "1 wk",  v: "RDS/Aurora + KMS + backups",    cost: "ops overhead" },
  { phase: "03 · Comms",     i: "Email provider integration",  t: "3 days", v: "SendGrid · SES · Postmark",     cost: "$12k+/yr" },
  { phase: "03 · Comms",     i: "SMS &amp; voice",                 t: "1 wk",  v: "Twilio",                         cost: "$18k+/yr + per-msg" },
  { phase: "03 · Comms",     i: "Multi-modal conversation",    t: "4 wks", v: "<b>not available off-shelf</b>",   cost: "build from scratch" },
  { phase: "03 · Comms",     i: "In-app notification UI",      t: "1 wk",  v: "in-house",                       cost: "engineering hours" },
  { phase: "04 · Build",     i: "UI component library",        t: "3 wks", v: "in-house · per app",             cost: "engineering hours" },
  { phase: "04 · Build",     i: "Scheduled job / cron",        t: "1 wk",  v: "Temporal · in-house · Sidekiq",  cost: "ops overhead" },
  { phase: "04 · Build",     i: "Document generation",         t: "2 wks", v: "in-house templating + PDFs",     cost: "engineering hours" },
  { phase: "04 · Build",     i: "Secrets handling",            t: "3 days", v: "Vault · AWS Secrets",            cost: "ops overhead" },
  { phase: "05 · Run",       i: "Hosting &amp; backups",           t: "1 wk",  v: "AWS / GCP / Azure",              cost: "compute + ops" },
  { phase: "05 · Run",       i: "Error monitoring",            t: "2 days", v: "Sentry · Datadog",               cost: "$15k+/yr" },
  { phase: "05 · Run",       i: "Durable workflows",           t: "3 wks", v: "Temporal · <b>not vibe-codeable</b>", cost: "engineering hours" },
  { phase: "05 · Run",       i: "Admin &amp; governance console",   t: "2 wks", v: "in-house",                       cost: "engineering hours" },
];

// Totals at the bottom
const totals = {
  decisions: 21,
  weeks: "12+",
  teamFunctions: 5,
  vendorCommits: "8–14",
  upfrontCost: "$200k+",
  annualVendorCost: "$250k+",
};
---

<section class="oa" id="one-automation">
  <div class="wrap">
    <div class="s-head">
      <span class="eyebrow"><span class="dot"></span>Section 05 &middot; The customer-side math</span>
      <h2>
        What it takes to ship <em>one</em><br/>
        enterprise-grade automation.
      </h2>
      <p class="lede">
        Before a single line of business logic gets written: 21 separate vendor decisions, 5+ team functions involved, $200k+ in upfront commitments, 12+ weeks of provisioning. Most enterprises asking for AI <b>never get past this list</b>. The ones that do, ship their first automation in roughly the time competitors ship their fifth on Assembly.
      </p>
    </div>

    <!-- Without Assembly -->
    <div class="without">
      <header class="w-head">
        <span class="w-tag">Without a platform</span>
        <h3>21 separate decisions, before any business logic</h3>
        <span class="w-meta">{totals.decisions} rows &middot; ~{totals.weeks} weeks &middot; {totals.teamFunctions}+ team functions</span>
      </header>

      <ol class="steps">
        {
          steps.map(({ phase, i, t, v, cost }) => (
            <li>
              <span class="s-phase">{phase}</span>
              <span class="s-item">{i}</span>
              <span class="s-time">{t}</span>
              <span class="s-vendor" set:html={v} />
              <span class="s-cost" set:html={cost} />
            </li>
          ))
        }
      </ol>

      <footer class="w-foot">
        <div class="wf-stat"><span class="wf-v">{totals.weeks}</span><span class="wf-k">weeks before logic written</span></div>
        <div class="wf-stat"><span class="wf-v">{totals.upfrontCost}</span><span class="wf-k">upfront, one automation</span></div>
        <div class="wf-stat"><span class="wf-v">{totals.annualVendorCost}</span><span class="wf-k">annual vendor stack</span></div>
        <div class="wf-stat"><span class="wf-v">~40%</span><span class="wf-k">of first attempts never ship</span></div>
      </footer>
    </div>

    <!-- With Assembly -->
    <div class="with">
      <header class="ws-head">
        <span class="ws-tag">With Assembly</span>
        <h3>One platform setup. Every automation inherits all 21.</h3>
      </header>
      <div class="ws-body">
        <p>
          The same twenty-one capabilities &mdash; identity, audit, governed data, comms, build primitives, run-with-confidence &mdash; are wired once during onboarding. Every app the customer's team builds from that point forward <b>inherits the entire substrate automatically</b>. No vendor sign-ups. No per-app rebuilds. No skip-the-audit-log-until-it-bites.
        </p>
        <div class="ws-stats">
          <div class="ws-stat">
            <span class="ws-v">1</span>
            <span class="ws-k">platform setup &middot; ~10 days</span>
          </div>
          <div class="ws-stat">
            <span class="ws-v">∞</span>
            <span class="ws-k">apps inherit the 21 capabilities</span>
          </div>
          <div class="ws-stat">
            <span class="ws-v">$0</span>
            <span class="ws-k">marginal vendor cost per app</span>
          </div>
          <div class="ws-stat">
            <span class="ws-v">~5×</span>
            <span class="ws-k">customer's apps-shipped-per-year vs baseline</span>
          </div>
        </div>
      </div>
    </div>

    <p class="closer">
      <span class="closer-tag">For the acquirer</span>
      Every existing client of yours has been quoted some version of <em>the without column</em> by their CIO or by you. Acquiring Assembly means walking into that conversation with <em>the with column</em>. <b>The deal closes itself.</b>
    </p>
  </div>
</section>

<style>
  .oa {
    padding: 120px 0;
    border-top: 1px solid var(--color-ink-100);
    background: var(--color-ink-50);
  }
  .s-head { max-width: 880px; margin-bottom: 48px; }
  .s-head .eyebrow { display: block; margin-bottom: 14px; }
  .s-head h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.022em;
    line-height: 1.15;
    color: var(--color-ink-950);
  }
  .s-head h2 em {
    font-style: normal;
    color: var(--color-indigo-600);
  }
  .s-head .lede {
    margin-top: 18px;
    font-size: 17px;
    color: var(--color-ink-700);
    line-height: 1.6;
    max-width: 780px;
  }
  .s-head .lede b { color: var(--color-ink-950); font-weight: 600; }

  /* ── Without ─────────────────────────────────────────── */
  .without {
    background: #fff;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 20px;
  }
  .w-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    background: var(--color-ink-50);
    border-bottom: 1px solid var(--color-ink-200);
  }
  @media (max-width: 820px) {
    .w-head { grid-template-columns: 1fr; gap: 6px; }
  }
  .w-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amber-fg);
    background: var(--color-amber-bg);
    padding: 4px 9px;
    border-radius: 4px;
  }
  .w-head h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.012em;
    color: var(--color-ink-950);
  }
  .w-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-500);
    letter-spacing: 0.02em;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: grid;
    grid-template-columns: 110px 1fr 60px 1fr 1fr;
    gap: 14px;
    padding: 11px 22px;
    border-top: 1px solid var(--color-ink-100);
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11.5px;
  }
  @media (max-width: 920px) {
    .steps li { grid-template-columns: 1fr 1fr; gap: 6px 12px; }
    .steps li .s-phase { grid-column: 1 / -1; }
    .steps li .s-item { grid-column: 1 / -1; font-size: 13px; }
  }
  .s-phase {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-indigo-700);
    background: var(--color-indigo-50);
    padding: 2px 7px;
    border-radius: 3px;
    display: inline-block;
    width: fit-content;
  }
  .s-item {
    font-family: var(--font-body);
    font-size: 13.5px;
    color: var(--color-ink-950);
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .s-time {
    color: var(--color-ink-700);
    font-weight: 600;
    text-align: right;
  }
  .s-vendor {
    color: var(--color-ink-500);
  }
  .s-vendor :global(b) { color: var(--color-amber-fg); font-weight: 600; }
  .s-cost {
    color: var(--color-amber-fg);
    text-align: right;
  }
  @media (max-width: 920px) {
    .s-time, .s-cost { text-align: left; }
  }

  .w-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 22px;
    background: var(--color-ink-950);
    color: rgba(255, 255, 255, 0.7);
    flex-wrap: wrap;
  }
  .wf-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .wf-v {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.018em;
    color: #fff;
    line-height: 1;
  }
  .wf-k {
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.04em;
  }

  /* ── With Assembly ──────────────────────────────────── */
  .with {
    background: var(--color-indigo-600);
    color: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(15,17,42,.04), 0 20px 56px -28px rgba(79, 70, 229, 0.5);
  }
  .ws-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    flex-wrap: wrap;
  }
  .ws-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-indigo-600);
    background: #fff;
    padding: 4px 9px;
    border-radius: 4px;
  }
  .ws-head h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.012em;
    color: #fff;
  }
  .ws-body {
    padding: 24px 22px;
  }
  .ws-body p {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.92);
    max-width: 800px;
  }
  .ws-body p b { color: #fff; font-weight: 600; }

  .ws-stats {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 720px) { .ws-stats { grid-template-columns: 1fr 1fr; } }
  .ws-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }
  .ws-v {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    letter-spacing: -0.022em;
    color: #fff;
    line-height: 1;
  }
  .ws-k {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  /* ── Closer ──────────────────────────────────────────── */
  .closer {
    margin-top: 28px;
    padding: 22px 28px;
    background: #fff;
    border: 1px solid var(--color-ink-200);
    border-radius: var(--radius-md);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    color: var(--color-ink-700);
    font-size: 15px;
    line-height: 1.6;
  }
  @media (max-width: 720px) {
    .closer { grid-template-columns: 1fr; gap: 10px; }
  }
  .closer-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-indigo-700);
    background: var(--color-indigo-50);
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
    align-self: start;
    padding-top: 6px;
  }
  .closer em { font-style: italic; color: var(--color-ink-950); }
  .closer b { color: var(--color-ink-950); font-weight: 600; }
</style>
